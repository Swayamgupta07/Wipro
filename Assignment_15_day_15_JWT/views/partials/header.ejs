<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JWT Role-Based Auth</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">EduJWT</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link" href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/about">About Us</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/contact">Contact Us</a>
        </li>

        <!-- RBAC Logic: Showing links based on authentication and role -->
        <% if (!user) { %>
            <li class="nav-item">
              <a class="nav-link fw-bold text-warning" href="/students">List of Students</a>
            </li>
            <li class="nav-item">
              <a class="nav-link fw-bold text-warning" href="/add-student">Add Student</a>
            </li>
        <% } else { %>
            <% if (user.role === 'teacher') { %>
                <li class="nav-item">
                  <a class="nav-link fw-bold text-warning" href="/students">List of Students</a>
                </li>
            <% } else if (user.role === 'student') { %>
                <li class="nav-item">
                  <a class="nav-link fw-bold text-warning" href="/add-student">Add Student</a>
                </li>
            <% } %>
        <% } %>
      </ul>

      <ul class="navbar-nav ms-auto border-start ps-3 border-light">
        <% if (user) { %>
            <li class="nav-item d-flex align-items-center me-3 text-white">
                <span class="badge bg-light text-primary me-2"><%= user.role.toUpperCase() %></span>
                Welcome, <%= user.name %>
            </li>
            <li class="nav-item">
              <a class="btn btn-outline-light btn-sm mt-1" href="/auth/logout">Log out</a>
            </li>
        <% } else { %>
            <li class="nav-item me-2">
              <a class="btn btn-outline-light" href="/auth/login">Sign In</a>
            </li>
            <li class="nav-item">
              <a class="btn btn-warning text-dark fw-bold" href="/auth/signup">Sign Up</a>
            </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<div class="container">
