<%- include('partials/header'); -%>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow border-0 rounded-4 mt-4">
            <div class="card-header bg-primary text-white p-3 rounded-top-4">
                <h4 class="mb-0"><i class="bi bi-person-plus-fill me-2"></i>Add Student Record</h4>
            </div>
            <div class="card-body p-4">
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger shadow-sm border-0"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %></div>
                <% } %>
                <!-- Only accessed by 'student' role due to middleware -->
                <form action="/add-student" method="POST">
                    <div class="mb-3">
                        <label class="form-label text-muted fw-bold">Full Name</label>
                        <input type="text" name="name" class="form-control bg-light border-0" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted fw-bold">Roll Number</label>
                        <input type="number" name="rollno" class="form-control bg-light border-0" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-muted fw-bold">Course</label>
                        <select name="course" class="form-select bg-light border-0" required>
                            <option value="Computer Science">Computer Science</option>
                            <option value="BCA">BCA</option>
                            <option value="Computer Science with IT">Computer Science with IT</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success w-100 fw-bold py-2">Submit Record</button>
                </form>
            </div>
        </div>
    </div>
</div>

</div>
</body>
</html>
