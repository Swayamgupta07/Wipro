<%- include('partials/header'); -%>

<div class="card shadow-sm border-0 rounded-4 mt-4">
    <div class="card-header bg-warning text-dark p-3 rounded-top-4 d-flex justify-content-between align-items-center">
        <h4 class="mb-0 fw-bold"><i class="bi bi-card-list me-2"></i>List of Enrolled Students</h4>
     
    </div>
    <div class="card-body p-0">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger m-3 border-0"><i class="bi bi-x-circle-fill me-2"></i><%= error %></div>
        <% } %>
       
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Roll No</th>
                    <th>Name</th>
                    <th>Course</th>
                </tr>
            </thead>
            <tbody>
                <% if (students.length === 0) { %>
                    <tr>
                        <td colspan="3" class="text-center py-4 text-muted">No students found in the database.</td>
                    </tr>
                <% } %>
                <% students.forEach(student => { %>
                    <tr>
                        <td class="ps-4 fw-bold">#<%= student.rollno %></td>
                        <td><%= student.name %></td>
                        <td><span class="badge bg-secondary"><%= student.course %></span></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

</div>
</body>
</html>
