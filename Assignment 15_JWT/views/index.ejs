<%- include('partials/header'); -%>

<div class="p-5 mb-4 bg-white rounded-3 shadow-sm text-center">
    <div class="container-fluid py-5">
        <h1 class="display-5 fw-bold text-primary">
            <% if (page === 'home') { %> Welcome to EduJWT Portal <% } %>
            <% if (page === 'about') { %> About Us <% } %>
            <% if (page === 'contact') { %> Contact Us <% } %>
        </h1>
        <p class="col-md-8 mx-auto fs-4 text-muted">
            <% if (page === 'home') { %> This is a secure portal implementing JSON Web Tokens (JWT) and Role-Based Access Control. <% } %>
            <% if (page === 'about') { %> Student logged in can add student and teacher logged in can show list of students. <% } %>
            <% if (page === 'contact') { %> Reach out to us at contact@edujwt.com or call +91-0000000000. <% } %>
        </p>
    </div>
</div>

</div>
</body>
</html>
